{
  "name": "xhs-live-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "26.x",
    "pnpm": "11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.4.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "browser:validate": "node scripts/validate-browser.mjs",
    "test:browser": "vitest run apps/desktop/src/main/browser",
    "dev": "node scripts/validate-browser.mjs",
    "start": "pnpm --filter apps-desktop start",
    "build": "pnpm --filter apps-desktop build",
    "package:win": "pnpm --filter apps-desktop build:win",
    "typecheck": "pnpm --filter @xhs-live-recorder/core typecheck && pnpm --filter apps-desktop typecheck",
    "test": "vitest run && node scripts/test-native.mjs",
    "check": "pnpm --filter apps-desktop lint && biome check packages/recorder-core/src scripts/validate-browser.mjs scripts/test-native.mjs",
    "format": "pnpm --filter apps-desktop format && biome format --write packages/recorder-core/src scripts",
    "dev:all": "pnpm dev",
    "build:all": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
